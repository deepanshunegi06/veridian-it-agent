# Which model answers. groq | gemini | openai | opencode
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# OpenCode Go (OpenAI-compatible). Model: mimo-v2.5, endpoint:
# https://opencode.ai/zen/go/v1/chat/completions - see https://opencode.ai/docs/go/
# LLM_PROVIDER=opencode, LLM_MODEL=mimo-v2.5
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SESSION_ID=veridian-it-desk-1

# Steps before the agent gives up and hands the request to a person.
MAX_STEPS=10

# Comma-separated explicit origins. Credentials are enabled, so "*" is never
# used; when empty or "*", the backend falls back to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# MongoDB persistence. Empty = in-memory fallback (tests, local runs).
MONGODB_URI=
VERIDIAN_DB=veridian_it_agent

# Deployment env. ENV=dev seeds local demo accounts on startup (see below);
# any other value disables dev defaults.
ENV=dev
# HS256 signing secret for access tokens. Use a long random value (>=32 chars)
# in any real deployment.
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
AUTH_COOKIE_NAME=veridian_access

# Demo seed accounts. Only used when ENV=dev and SEED_DEMO_USERS=true.
# Never commit real passwords; these development defaults are documented and
# are not created outside dev. Passwords are never printed by the seed.
SEED_DEMO_USERS=true
DEMO_EMPLOYEE_EMAIL=employee@veridian.local
DEMO_AGENT_EMAIL=agent@veridian.local
DEMO_ADMIN_EMAIL=admin@veridian.local
DEMO_EMPLOYEE_PASSWORD=Employee-Demo-01!
DEMO_AGENT_PASSWORD=Agent-Demo-01!
DEMO_ADMIN_PASSWORD=Admin-Demo-01!
